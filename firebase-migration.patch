+  dueDate?: Date;
+}) {
+  const rulesSnap = await col.rules(userId).where("enabled", "==", true).get();
+  const rules = (rulesSnap.docs.map(docData) as any[]).sort((a, b) => (b.priority ?? 0) - (a.priority ?? 0));
